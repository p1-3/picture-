--// ========== Universal interact (ใช้กับตู้เย็น/เตา) ==========
local function prepPrompt(p)
    pcall(function()
        p.Enabled = true
        p.RequiresLineOfSight = false
        p.HoldDuration = 0
        if p.MaxActivationDistance < 30 then p.MaxActivationDistance = 30 end
    end)
end

local function findTouchPart(obj)
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then
        return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
    end
    local inner = obj:FindFirstChildWhichIsA("BasePart", true)
    if inner then return inner end
    local par = obj.Parent
    if par and par:IsA("BasePart") then return par end
    if par and par:IsA("Model") then
        return par.PrimaryPart or par:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

local function interact(obj, label)
    if not obj then print("[Interact]", label or "?", "= nil"); return false end
    print(("[Interact] %s → %s [%s]"):format(label or "?", obj:GetFullName(), obj.ClassName))
    local handled = false

    if obj:IsA("ProximityPrompt") then
        prepPrompt(obj)
        pcall(fireproximityprompt, obj)
        handled = true
    elseif obj:IsA("ClickDetector") then
        pcall(fireclickdetector, obj)
        handled = true
    elseif obj:IsA("RemoteEvent") then
        for _, a in ipairs({"Start","Accept","Begin","Open","Trigger"}) do
            pcall(function() obj:FireServer(a) end)
        end
        pcall(function() obj:FireServer() end)
        handled = true
    end

    for _, d in pairs(obj:GetDescendants()) do
        if d:IsA("ProximityPrompt") then
            prepPrompt(d)
            pcall(fireproximityprompt, d); handled = true
        elseif d:IsA("ClickDetector") then
            pcall(fireclickdetector, d); handled = true
        end
    end

    if hasTouchInterest then
        local tp = findTouchPart(obj)
        if tp then
            local hrp = getHRP()
            if hrp then
                pcall(function() firetouchinterest(hrp, tp, 0) end)
                task.wait(0.05)
                pcall(function() firetouchinterest(hrp, tp, 1) end)
                handled = true
            end
        end
    end
    return handled
end

--// ========== กดรับงาน "ครั้งเดียว" ==========
local function pressShiftOnce()
    local obj = getShiftObj()
    if not obj then
        print("[AutoCook] ❌ ไม่เจอ MD_CookShift")
        return false
    end
    print(("[AutoCook] กดรับงาน → %s [%s]"):format(obj:GetFullName(), obj.ClassName))

    -- 1) ProximityPrompt
    local prompt = obj:IsA("ProximityPrompt") and obj or obj:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        pcall(function() prompt.Enabled = true end)
        pcall(fireproximityprompt, prompt)
        return true
    end

    -- 2) ClickDetector
    local cd = obj:IsA("ClickDetector") and obj or obj:FindFirstChildWhichIsA("ClickDetector", true)
    if cd then
        pcall(fireclickdetector, cd)
        return true
    end

    -- 3) Touch
    local part = obj:IsA("BasePart") and obj or obj.Parent
    local hrp = getHRP()
    if hasTouchInterest and part and part:IsA("BasePart") and hrp then
        pcall(function() firetouchinterest(hrp, part, 0) end)
        task.wait(0.05)
        pcall(function() firetouchinterest(hrp, part, 1) end)
        return true
    end

    return false
end

