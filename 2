--// ========== Object resolvers ==========
local function resolve(...)
    local obj = workspace
    for _, n in ipairs({...}) do
        if type(n) == "number" then
            obj = obj:GetChildren()[n]
        else
            obj = obj:FindFirstChild(n)
        end
        if not obj then return nil end
    end
    return obj
end

local function getShiftObj()
    return resolve("Map","Tiles","ShoppingTile","SteakHouse","Interior","SteakHouseBeacon","TouchPart","MD_CookShift")
end

local function getFridgeObj()
    local interior = resolve("Map","Tiles","ShoppingTile","SteakHouse","Interior")
    if not interior then return nil end
    local fridge = interior:FindFirstChild("Fridge")
    if not fridge then return nil end

    -- พาธหลัก: Interior.Fridge.Base
    local base = fridge:FindFirstChild("Base")
    if base then
        return base:FindFirstChild("MD_CookFridge") or base
    end

    -- fallback: หาตามชื่อ
    for _, d in pairs(fridge:GetDescendants()) do
        if d.Name == "MD_CookFridge" then return d end
    end
    return nil
end

-- ตำแหน่งของ object ไม่ว่าจะเป็น Part / Model / Prompt
local function objPos(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then return obj.Position end
    if obj:IsA("Model") then
        local ok, cf = pcall(function() return obj:GetPivot() end)
        if ok and cf then return cf.Position end
    end
    local par = obj.Parent
    while par and par ~= workspace do
        if par:IsA("BasePart") then return par.Position end
        if par:IsA("Model") then
            local ok, cf = pcall(function() return par:GetPivot() end)
            if ok and cf then return cf.Position end
        end
        par = par.Parent
    end
    return nil
end

local function getGrillObj()
    local interior = resolve("Map","Tiles","ShoppingTile","SteakHouse","Interior")
    if not interior then return nil end

    -- รวมผู้สมัครทุกเตาใน Interior (MD_CookGrill หรือ GrillArea ที่ไม่มี MD_CookGrill ข้างใน)
    local candidates = {}
    for _, d in ipairs(interior:GetDescendants()) do
        if d.Name == "MD_CookGrill" then
            table.insert(candidates, d)
        elseif d.Name == "GrillArea" and not d:FindFirstChild("MD_CookGrill", true) then
            table.insert(candidates, d)
        end
    end

    -- เลือกอันที่ใกล้จุดยืนเตา (POS_GRILL) ที่สุด
    local best, bestDist
    for _, c in ipairs(candidates) do
        local pos = objPos(c)
        if pos then
            local dist = (pos - POS_GRILL).Magnitude
            if not bestDist or dist < bestDist then
                best, bestDist = c, dist
            end
        end
    end
    if best then return best, bestDist end

    -- fallback: พาธที่เคยให้มา
    local c65 = interior:GetChildren()[65]
    local ga = c65 and c65:FindFirstChild("GrillArea")
    if ga then return ga:FindFirstChild("MD_CookGrill") or ga end
    return nil
end

