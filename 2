--// ========== Beam / Tween ==========
local function showBeam(fromPos, toPos, duration)
    if activeBeam and activeBeam.Parent then activeBeam:Destroy() end
    local dist = (toPos - fromPos).Magnitude
    if dist < 2 then return end
    local part = Instance.new("Part")
    part.Name = "AutoCookGuide"
    part.Anchored = true; part.CanCollide = false
    part.CanQuery = false; part.CanTouch = false
    part.Material = Enum.Material.Neon
    part.Color = Color3.fromRGB(0, 255, 170)
    part.Transparency = 0.35
    part.Size = Vector3.new(0.4, 0.4, dist)
    part.CFrame = CFrame.lookAt((fromPos + toPos)/2, toPos)
    part.Parent = workspace
    activeBeam = part
    task.delay(duration + 0.5, function()
        if not part.Parent then return end
        for i = 1, 10 do
            if not part.Parent then break end
            part.Transparency = 0.35 + i * 0.065
            task.wait(0.05)
        end
        if part.Parent then part:Destroy() end
    end)
end

local function tweenWalk(targetPos, speed)
    local char = getChar()
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    if not hrp then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then hum.WalkSpeed = speed end

    local startPos = hrp.Position
    local flatDist = (Vector3.new(startPos.X,0,startPos.Z) - Vector3.new(targetPos.X,0,targetPos.Z)).Magnitude
    if flatDist < 2 then
        pcall(function() hrp.CFrame = CFrame.new(targetPos) end)
        return true
    end

    local duration = math.max(flatDist / speed, 0.2)
    showBeam(startPos, targetPos, duration)

    if activeTween then pcall(function() activeTween:Cancel() end) end
    activeTween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = CFrame.new(targetPos) })
    local done = false
    local conn = activeTween.Completed:Connect(function() done = true end)
    activeTween:Play()

    local t = 0
    while not done and t < duration + 5 do
        task.wait(0.05); t = t + 0.05
        if not hrp or not hrp.Parent then break end
    end
    conn:Disconnect(); activeTween = nil
    if hrp and hrp.Parent then pcall(function() hrp.CFrame = CFrame.new(targetPos) end) end
    return true
end

--// ========== Steps ==========
local function stepAccept()
    if shiftStarted then return true end

    setStatus("🚶 ไปจุดรับงาน (speed " .. SPEED_BEFORE .. ")")
    tweenWalk(POS_ACCEPT, SPEED_BEFORE)
    task.wait(0.3)

    setStatus("🔵 กดรับงาน (ครั้งเดียว)...")
    pressShiftOnce()

    -- รอ Feedback จริงจาก server
    local t = 0
    while running and not shiftStarted and t < ACCEPT_TIMEOUT do
        task.wait(0.1)
        t = t + 0.1
    end

    if not shiftStarted then
        setStatus("⚠️ server ยังไม่ตอบ จะลองใหม่", Color3.fromRGB(255,200,80))
    end
    return shiftStarted
end

local function stepFridge()
    -- เดิน/วาร์ปเข้าจุดตู้เย็นเสมอ (ถ้ายืนอยู่แล้วฟังก์ชันจะแค่ snap ตำแหน่ง ไม่เสียเวลา)
    setStatus("🚶 ไปตู้เย็น (speed " .. SPEED_AFTER .. ")")
    tweenWalk(POS_FRIDGE, SPEED_AFTER)
    task.wait(0.3)

    setStatus("🧊 กด MD_CookFridge")
    for i = 1, 5 do
        if not running then return end
        interact(getFridgeObj(), "MD_CookFridge")
        task.wait(0.4)
    end
    task.wait(0.4)
end

local function stepGrill()
    setStatus("🚶 ไปเตาย่าง (speed " .. SPEED_AFTER .. ")")
    tweenWalk(POS_GRILL, SPEED_AFTER)
    task.wait(0.3)
    local hrp = getHRP()

    local grill, gdist = getGrillObj()
    if grill then
        print(("[AutoCook] เตาที่เลือก: %s [%s] ห่าง POS_GRILL %.1f studs"):format(grill:GetFullName(), grill.ClassName, gdist or -1))
        if gdist and gdist > 20 then
            warn("[AutoCook] ⚠️ เตาที่เจออยู่ไกลจาก POS_GRILL มาก ตรวจพิกัดเตาอีกที")
        end
    else
        warn("[AutoCook] ❌ ไม่เจอเตาเลย")
    end

    setStatus("🔥 กด MD_CookGrill")
    if hrp then
        for i = 1, 4 do
            if not running then return end
            pcall(function() hrp.CFrame = CFrame.new(POS_GRILL + Vector3.new(0,0,1.5)) end)
            task.wait(0.15)
            pcall(function() hrp.CFrame = CFrame.new(POS_GRILL + Vector3.new(0,0,-1.5)) end)
            task.wait(0.15)
            if not grill or not grill.Parent then grill = getGrillObj() end
            interact(grill, "MD_CookGrill")
            task.wait(0.2)
        end
    end
    task.wait(0.5)
end

local function stepCook()
    -- วางสเต็กเสร็จ → ไปรอหน้าตู้เย็นทันที
    setStatus("🚶 กลับไปรอหน้าตู้เย็น")
    tweenWalk(POS_FRIDGE, SPEED_AFTER)

    for i = WAIT_BEFORE_REMOTE, 1, -1 do
        if not running then return end
        setStatus(("⏳ รอหน้าตู้เย็น %d วิ ก่อนยิงรีโมท..."):format(i), Color3.fromRGB(255,200,80))
        task.wait(1)
    end

    setStatus("🔥 Finish (ยิง MD_CookRemote)")
    pcall(function() if CookRemote then CookRemote:FireServer("Finish") end end)
    task.wait(0.2)
    for _, a in ipairs({"finish_grilling_2","Finish","finish"}) do
        pcall(function() if CookRemote then CookRemote:FireServer(a) end end)
    end
    task.wait(0.3)
    pcall(function()
        if firesignal and CookRemote then
            firesignal(CookRemote.OnClientEvent, "Finished", "Perfect!", 160, 26)
        end
        if firesignal and CashFX then
            firesignal(CashFX.OnClientEvent, "Pickup", 160)
        end
    end)
    task.wait(AFTER_FINISH_WAIT)
end

local function mainLoop()
    while running do
        local ok, err = pcall(function()
            if not shiftStarted then
                if not stepAccept() then
                    task.wait(1); return
                end
            end
            if not running then return end
            stepFridge()
            if not running then return end
            stepGrill()
            if not running then return end
            stepCook()
            task.wait(0.1)
        end)
        if not ok then warn("[AutoCook] Error:", err); task.wait(1) end
    end
end

